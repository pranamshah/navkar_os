generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  clientId       String    @unique
  name           String
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  phone          String?
  whatsapp       String?
  role           Role      @default(CLIENT)
  status         Status    @default(PENDING_VERIFICATION)

  // Business details
  businessName    String?
  businessType    BusinessType?
  city            String?
  state           String?
  stateCode       String?
  gstin           String?
  pan             String?
  iecCode         String?
  chaLicenceNo    String?
  businessAddress String?
  yearsInBusiness String?

  // Document uploads (Cloudinary URLs)
  gstCertPath     String?
  panCopyPath     String?
  licenceCopyPath String?

  // Verification
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?

  // OTP for Client ID login
  otpCode         String?
  otpExpiry       DateTime?

  // Relations
  subscriptions   Subscription[]
  invoices        Invoice[]
  tickets         Ticket[]
  notifications   Notification[]
  accounts        Account[]
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                 String       @id @default(cuid())
  userId             String
  product            Product
  plan               Plan
  billingCycle       BillingCycle
  status             SubStatus    @default(TRIAL)
  amount             Int
  trialEndsAt        DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  razorpaySubId      String?
  razorpayPlanId     String?
  cancelledAt        DateTime?
  user               User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
}

model Invoice {
  id        String    @id @default(cuid())
  invoiceNo String    @unique
  userId    String
  product   Product
  amount    Int
  status    PayStatus @default(PENDING)
  razorpayId String?
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
}

model Ticket {
  id         String       @id @default(cuid())
  ticketId   String       @unique
  userId     String?
  name       String
  email      String
  message    String
  status     TicketStatus @default(OPEN)
  source     String       @default("CHATBOT")
  adminReply String?
  resolvedAt DateTime?
  user       User?        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  type    String
  title   String
  message String
  read    Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// ─── Accura Accounting Module ─────────────────────────────────

model LedgerGroup {
  id       String  @id @default(cuid())
  userId   String
  name     String
  parentId String?
  parent   LedgerGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children LedgerGroup[] @relation("GroupTree")
  nature   String        // ASSETS / LIABILITIES / INCOME / EXPENSE
  isSystem Boolean       @default(false)
  ledgers  Ledger[]

  @@index([userId])
}

model Ledger {
  id              String      @id @default(cuid())
  userId          String
  name            String
  groupId         String
  group           LedgerGroup @relation(fields: [groupId], references: [id])
  openingBalance  Int         @default(0)
  openingType     String      @default("Dr")
  gstin           String?
  pan             String?
  creditPeriod    Int         @default(0)
  billByBill      Boolean     @default(false)
  tdsSection      String?
  isFreightLedger Boolean     @default(false)
  jobNo           String?
  currency        String      @default("INR")
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  voucherLines    VoucherLine[]
  billAllocations BillAllocation[]

  @@index([userId])
}

model Voucher {
  id            String      @id @default(cuid())
  userId        String
  voucherType   String
  voucherNo     String
  date          DateTime
  narration     String?
  totalAmount   Int
  status        String      @default("ACTIVE")
  irnNumber     String?
  costCentre    String?
  jobNo         String?
  attachmentUrl String?
  lines         VoucherLine[]
  bills         BillAllocation[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([userId, date])
}

model VoucherLine {
  id           String   @id @default(cuid())
  voucherId    String
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId     String
  ledger       Ledger   @relation(fields: [ledgerId], references: [id])
  type         String
  amount       Int
  cgst         Int      @default(0)
  sgst         Int      @default(0)
  igst         Int      @default(0)
  costCentre   String?
  narration    String?
  currency     String   @default("INR")
  forexAmount  Float?
  exchangeRate Float?
}

model BillAllocation {
  id        String   @id @default(cuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id])
  billRef   String
  billDate  DateTime
  amount    Int
  type      String
}

model AccuraEmployee {
  id          String       @id @default(cuid())
  userId      String
  name        String
  designation String
  basic       Int
  hra         Int
  special     Int
  pan         String?
  bankAccount String?
  ifsc        String?
  joiningDate DateTime
  isActive    Boolean      @default(true)
  salarySlips SalarySlip[]

  @@index([userId])
}

model SalarySlip {
  id         String         @id @default(cuid())
  employeeId String
  employee   AccuraEmployee @relation(fields: [employeeId], references: [id])
  month      Int
  year       Int
  gross      Int
  tds        Int            @default(0)
  pf         Int            @default(0)
  advance    Int            @default(0)
  net        Int
  pdfUrl     String?
  paidDate   DateTime?
  voucherId  String?
  createdAt  DateTime       @default(now())
}

model BankStatement {
  id               String   @id @default(cuid())
  userId           String
  bankLedgerId     String
  date             DateTime
  description      String
  debit            Int      @default(0)
  credit           Int      @default(0)
  balance          Int
  matched          Boolean  @default(false)
  matchedVoucherId String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model ExchangeRate {
  id       String   @id @default(cuid())
  userId   String
  currency String
  date     DateTime
  rate     Float
}

enum Role {
  SUPERADMIN
  ADMIN
  CLIENT
}

enum Status {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BusinessType {
  CF_AGENT
  FREIGHT_FORWARDER
  CHA
  IMPORTER_EXPORTER
  CFS_WAREHOUSE
  TRANSPORTER
  OTHER
}

enum Product {
  NEXLOG
  ENTRYX
  DOCKIQ
  RUNDESK
  ACCURA
  TRADEPILOT
  FORWARDER_BUNDLE
  CHA_BUNDLE
  CFS_BUNDLE
  TRANSPORTER_BUNDLE
  FULL_SUITE
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PayStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Nexlog Freight Forwarding Module ────────────────────────

model NexClient {
  id           String   @id @default(cuid())
  userId       String
  clientCode   String   @unique
  companyName  String
  contactName  String
  phone        String
  email        String?
  address      String?
  city         String?
  state        String?
  gstin        String?
  pan          String?
  iecCode      String?
  creditLimit  Int      @default(0)
  creditDays   Int      @default(0)
  kycComplete  Boolean  @default(false)
  jobs         NexJob[]
  enquiries    NexEnquiry[]
  quotations   NexQuotation[]
  leads        NexLead[]
  createdAt    DateTime @default(now())
  @@index([userId])
}

model NexJob {
  id              String    @id @default(cuid())
  userId          String
  jobNo           String    @unique
  jobType         String
  mode            String
  clientId        String
  client          NexClient @relation(fields: [clientId], references: [id])
  clientRef       String?
  handler         String?
  status          String    @default("ACTIVE")
  stage           String    @default("JOB_CREATED")
  countryOrigin   String?
  portLoading     String?
  portDischarge   String?
  finalDest       String?
  commodity       String?
  hsCode          String?
  packages        Int?
  packageType     String?
  grossWeight     Float?
  netWeight       Float?
  cbm             Float?
  cargoNature     String    @default("GENERAL")
  shippingLine    String?
  linerBookingRef String?
  vessel          String?
  voyage          String?
  mblNo           String?
  hblNo           String?
  mawbNo          String?
  hawbNo          String?
  flightNo        String?
  sailingDate     DateTime?
  etaOriginal     DateTime?
  etaUpdated      DateTime?
  arrivalDate     DateTime?
  chaName         String?
  beNo            String?
  sbNo            String?
  beDate          DateTime?
  sbDate          DateTime?
  assessValue     BigInt?
  dutyAmount      BigInt?
  examType        String?
  clearanceDate   DateTime?
  cfsName         String?
  gateInDate      DateTime?
  igmNo           String?
  destuffDate     DateTime?
  freeDays        Int       @default(10)
  transporter     String?
  vehicleNos      String?
  lrNo            String?
  gateOutDate     DateTime?
  deliveryDate    DateTime?
  internalNotes   String?
  clientAccessPin String?   // 6-digit PIN for external client shipment tracking
  isLocked        Boolean   @default(false)
  containers      NexContainer[]
  documents       NexDocument[]
  charges         NexCharge[]
  invoices        NexInvoice[]
  trackingUpdates NexTracking[]
  comms           NexComm[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
}

model NexContainer {
  id          String  @id @default(cuid())
  jobId       String
  job         NexJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  containerNo String
  sealNo      String?
  size        String
  type        String  @default("DC")
  tare        Float?
  vgmWeight   Float?
}

model NexDocument {
  id          String   @id @default(cuid())
  jobId       String
  job         NexJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type        String
  label       String
  fileUrl     String
  fileSize    Int?
  uploadedBy  String
  shareToken  String?
  shareExpiry DateTime?
  createdAt   DateTime @default(now())
}

model NexCharge {
  id            String   @id @default(cuid())
  jobId         String
  job           NexJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category      String
  vendorName    String
  vendorRef     String?
  amount        Int
  cgst          Int      @default(0)
  sgst          Int      @default(0)
  igst          Int      @default(0)
  paymentStatus String   @default("PENDING")
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

model NexTracking {
  id           String   @id @default(cuid())
  jobId        String
  job          NexJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage        String
  notes        String?
  notifyClient Boolean  @default(false)
  updatedBy    String
  createdAt    DateTime @default(now())
}

model NexComm {
  id        String   @id @default(cuid())
  jobId     String
  job       NexJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String
  subject   String?
  content   String
  sentTo    String?
  createdAt DateTime @default(now())
}

model NexInvoice {
  id             String   @id @default(cuid())
  userId         String
  invoiceNo      String   @unique
  jobId          String?
  job            NexJob?  @relation(fields: [jobId], references: [id])
  clientId       String
  type           String
  currency       String   @default("INR")
  exchangeRate   Float    @default(1)
  date           DateTime
  dueDate        DateTime?
  items          Json
  subtotal       Int
  cgst           Int      @default(0)
  sgst           Int      @default(0)
  igst           Int      @default(0)
  totalAmount    Int
  status         String   @default("DRAFT")
  amountReceived Int      @default(0)
  paidDate       DateTime?
  paymentRef     String?
  createdAt      DateTime @default(now())
  @@index([userId])
}

model NexPartner {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  scacCode  String?
  gstin     String?
  contact   String?
  email     String?
  phone     String?
  country   String   @default("India")
  notes     String?
  createdAt DateTime @default(now())
  @@index([userId])
}

model NexRateCard {
  id            String   @id @default(cuid())
  userId        String
  partnerName   String
  type          String
  originPort    String?
  destPort      String?
  containerSize String?
  currency      String   @default("INR")
  amount        Int
  validFrom     DateTime
  validTo       DateTime
  notes         String?
  createdAt     DateTime @default(now())
  @@index([userId])
}

model NexFundRequest {
  id             String   @id @default(cuid())
  userId         String
  jobId          String?
  vendor         String
  amount         Int
  purpose        String
  urgency        String   @default("NORMAL")
  status         String   @default("PENDING")
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime @default(now())
  @@index([userId])
}

model NexLead {
  id           String     @id @default(cuid())
  userId       String
  source       String
  companyName  String
  contactName  String
  phone        String
  email        String?
  city         String?
  cargoType    String?
  tradeLane    String?
  status       String     @default("NEW")
  assignedTo   String?
  followUpDate DateTime?
  notes        String?
  clientId     String?
  client       NexClient? @relation(fields: [clientId], references: [id])
  enquiries    NexEnquiry[]
  createdAt    DateTime   @default(now())
  @@index([userId])
}

model NexEnquiry {
  id            String        @id @default(cuid())
  userId        String
  enquiryNo     String        @unique
  leadId        String?
  lead          NexLead?      @relation(fields: [leadId], references: [id])
  clientId      String?
  client        NexClient?    @relation(fields: [clientId], references: [id])
  type          String
  originPort    String
  destPort      String
  commodity     String?
  hsCode        String?
  weight        Float?
  cbm           Float?
  containerType String?
  count         Int           @default(1)
  incoterms     String?
  targetDate    DateTime?
  notes         String?
  quotations    NexQuotation[]
  createdAt     DateTime      @default(now())
  @@index([userId])
}

model AdminDevice {
  id          String   @id @default(cuid())
  token       String   @unique          // UUID stored in browser cookie
  name        String?                   // friendly name set by admin
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String
  status    String   @default("UNREAD") // UNREAD | READ | ARCHIVED
  createdAt DateTime @default(now())
}

model NexQuotation {
  id          String       @id @default(cuid())
  userId      String
  quoteNo     String       @unique
  enquiryId   String?
  enquiry     NexEnquiry?  @relation(fields: [enquiryId], references: [id])
  clientId    String?
  client      NexClient?   @relation(fields: [clientId], references: [id])
  items       Json
  totalAmount Int
  currency    String       @default("INR")
  status      String       @default("DRAFT")
  validTill   DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  jobId       String?
  createdAt   DateTime     @default(now())
  @@index([userId])
}
